# A vitrine deve sempre receber a versão mais recente do HTML.
/
  Cache-Control: no-store, max-age=0
/index.html
  Cache-Control: no-store, max-age=0
/*.html
  Cache-Control: no-store, max-age=0

# JS, CSS e fotos podem revalidar com ETag, sem ficar presos a cópias antigas.
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/editorial.css
  Cache-Control: public, max-age=0, must-revalidate
/images/editorial/*
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/price-offers.css
  Cache-Control: public, max-age=0, must-revalidate

/editor.html
  Cache-Control: no-store, max-age=0
  Referrer-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
/storefront-settings.js
  Cache-Control: public, max-age=0, must-revalidate
/store-settings.js
  Cache-Control: public, max-age=0, must-revalidate
/editor.js
  Cache-Control: public, max-age=0, must-revalidate

/ops/*
  Cache-Control: no-store
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

/account-ui.css
  Cache-Control: public, max-age=0, must-revalidate
